# 복사해서 .env 로 사용: cp .env.example .env
ANTHROPIC_API_KEY=

# 사용할 Claude 모델 (기본값: claude-opus-5)
# 비용을 줄이려면 claude-sonnet-5 / claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5

# MLflow 트래킹 서버
MLFLOW_TRACKING_URI=https://mlflow.dove-nest.com
MLFLOW_EXPERIMENT_NAME=langchain-study
# 서버에 basic-auth 를 켜면 아래 값 설정
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
